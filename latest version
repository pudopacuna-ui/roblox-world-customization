local bodyOriginals = setmetatable({}, { __mode = "k" })

local function applyCharacter()
    if not charEnabled then return end
    local char = lp.Character
    if not char then return end
    local C = Config.Character
    local root = char:FindFirstChild("HumanoidRootPart")

    -- highlight
    local hl = char:FindFirstChild("WE_HL")
    if C.Highlight then
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = "WE_HL"
            hl.Parent = char
        end
        hl.FillColor, hl.OutlineColor, hl.FillTransparency = C.Fill, C.Outline, C.FillTransparency
    elseif hl then
        hl:Destroy()
    end

    -- body recolor / material / transparency
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part ~= root then
            if not bodyOriginals[part] then
                bodyOriginals[part] = { part.Color, part.Material, part.Transparency }
            end
            local orig = bodyOriginals[part]
            if orig[3] < 0.99 then
                part.Material = (C.Material ~= "") and Enum.Material[C.Material] or orig[2]
                part.Color = C.UseColor and C.BodyColor or orig[1]
                part.Transparency = orig[3] + (1 - orig[3]) * C.BodyTransparency
            end
        end
    end

    if root then
        -- trail
        local trail = root:FindFirstChild("WE_Trail")
        if C.Trail then
            if not trail then
                local a0 = Instance.new("Attachment")
                a0.Name = "WE_A0"
                a0.Position = V3(0, 1, 0)
                a0.Parent = root
                local a1 = Instance.new("Attachment")
                a1.Name = "WE_A1"
                a1.Position = V3(0, -1, 0)
                a1.Parent = root
                trail = Instance.new("Trail")
                trail.Name = "WE_Trail"
                trail.Attachment0, trail.Attachment1 = a0, a1
                trail.Lifetime, trail.LightEmission = 0.6, 1
                trail.Transparency = NumberSequence.new(0.1, 1)
                trail.Parent = root
            end
            trail.Color = ColorSequence.new(C.Fill)
        elseif trail then
            trail:Destroy()
            for _, n in ipairs({ "WE_A0", "WE_A1" }) do
                local at = root:FindFirstChild(n)
                if at then at:Destroy() end
            end
        end

        -- aura
        local aura = root:FindFirstChild("WE_Aura")
        if C.Aura then
            if not aura then
                aura = Instance.new("ParticleEmitter")
                aura.Name = "WE_Aura"
                aura.Texture = "rbxasset://textures/particles/sparkles_main.dds"
                aura.Rate, aura.Lifetime, aura.Speed = 40, NumberRange.new(1, 1.6), NumberRange.new(1, 3)
                aura.SpreadAngle = Vector2.new(180, 180)
                aura.Size = NumberSequence.new(0.5, 0)
                aura.LightEmission = 1
                aura.Parent = root
            end
            aura.Color = ColorSequence.new(C.Fill)
        elseif aura then
            aura:Destroy()
        end
    end
end

local function enableCharacter()
    charEnabled = true
    applyCharacter()
end

----------------------------------------------------------------------
-- GEAR: shared part builder
-- Cones / spikes / blades are made of real triangles (every triangle is
-- two WedgeParts), so surfaces are smooth with no "stair steps".
----------------------------------------------------------------------
local function makeBuilder(specs)
    local S = { meta = {} }
    local chain

    local function put(t)
        t.chain = chain
        specs[#specs + 1] = t
    end

    local function add(shape, size, cf, role, ex)
        put({
            shape = shape, size = size, cf = cf, role = role or "main",
            spin = ex and ex.spin, bob = ex and ex.bob, light = ex and ex.light,
        })
    end

    -- cloak rows use a chain id so the physics step can drive them
    function S.setChain(c, r)
        chain = c and { c = c, r = r } or nil
    end

    -- vertical cylinder (axis along Y)
    function S.cyl(d, h, cf, role, ex)
        add(Enum.PartType.Cylinder, V3(h, d, d), cf * CFrame.Angles(0, 0, PI / 2), role, ex)
    end

    function S.ball(d, cf, role, ex)
        add(Enum.PartType.Ball, V3(d, d, d), cf, role, ex)
    end

    function S.block(size, cf, role, ex)
        add(Enum.PartType.Block, size, cf, role, ex)
    end

    -- arbitrary triangle a-b-c made from two wedges
    function S.tri(a, b, c, role)
        local ab, ac, bc = b - a, c - a, c - b
        local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
        if abd > acd and abd > bcd then
            c, a = a, c
        elseif acd > bcd and acd > abd then
            a, b = b, a
        end
        ab, ac, bc = b - a, c - a, c - b

        local n = ac:Cross(ab)
        if n.Magnitude < 1e-6 or bc.Magnitude < 1e-6 then return end
        local right = n.Unit
        local up    = bc:Cross(right).Unit
        local back  = bc.Unit

        local height = math.abs(ab:Dot(up))
        if height < 1e-4 then return end
        local z1, z2 = math.abs(ab:Dot(back)), math.abs(ac:Dot(back))

        if z1 > 1e-4 then
            put({ wedge = true, size = V3(0.05, height, z1), role = role or "main",
                cf = CFrame.fromMatrix((a + b) / 2, right, up, back) })
        end
        if z2 > 1e-4 then
            put({ wedge = true, size = V3(0.05, height, z2), role = role or "main",
                cf = CFrame.fromMatrix((a + c) / 2, -right, up, -back) })
        end
    end

    function S.quad(a, b, c, d, role)
        S.tri(a, b, c, role)
        S.tri(a, c, d, role)
    end

    -- frustum (r1 at the bottom, r2 at the top) - used for curved horns
    function S.frustum(r1, r2, h, cf, role, sides)
        sides = sides or 6
        local lo, hi = {}, {}
        for i = 0, sides - 1 do
            local ang = i / sides * PI * 2
            lo[i] = cf * V3(math.cos(ang) * r1, 0, math.sin(ang) * r1)
            hi[i] = cf * V3(math.cos(ang) * r2, h, math.sin(ang) * r2)
        end
        for i = 0, sides - 1 do
            local j = (i + 1) % sides
            S.quad(lo[i], lo[j], hi[j], hi[i], role)
        end
    end

    -- cone: r = base radius, h = height, cf = base (tip points along +Y),
    -- sides = face count, rim = { role =, frac = } optional contrasting band at the base
    function S.cone(r, h, cf, role, sides, rim)
        sides = sides or 32
        local apex = cf * V3(0, h, 0)
        local function ring(frac)
            local rr, y = r * (1 - frac), h * frac
            local pts = {}
            for i = 0, sides - 1 do
                local a = i / sides * PI * 2
                pts[i] = cf * V3(math.cos(a) * rr, y, math.sin(a) * rr)
            end
            return pts
        end
        local base = ring(0)
        local top = rim and ring(rim.frac) or base
        for i = 0, sides - 1 do
            local j = (i + 1) % sides
            S.tri(apex, top[i], top[j], role)
            if rim then
                S.tri(base[i], base[j], top[i], rim.role)
                S.tri(base[j], top[j], top[i], rim.role)
            end
        end
    end

    return S
end

