            name = name,
            callback = function()
                for k, v in pairs(ArmorPresets[name]) do A[k] = v end
                refreshControls()
                armorLook()
            end,
        })
    end

    tab:CreateSection({ name = "Colors" })
    addColor(tab, "Main (steel)", "Armor", A, "Main", armorLook)
    addColor(tab, "Trim (edges, spikes)", "Armor", A, "Trim", armorLook)
    addColor(tab, "Glow (runes, core)", "Armor", A, "Glow", armorLook)
    addColor(tab, "Cloak cloth", "Armor", A, "Cloth", armorLook)
    addColor(tab, "Fur", "Armor", A, "Fur", armorLook)

    tab:CreateSection({ name = "Look" })
    addSlider(tab, "Transparency", "Armor", A, "Transparency", 0, 0.9, 0.01, nil, armorLook)
    addSlider(tab, "Glow light brightness", "Armor", A, "GlowLight", 0, 5, 0.05, nil, armorLook)
    addToggle(tab, "Highlight (colors from the Character tab)", "Armor", A, "Highlight", armorLook)
    tab:CreateDropdown({
        name = "Metal material",
        flag = "Armor_Material",
        options = { "Metal", "DiamondPlate", "CorrodedMetal", "Slate", "Granite", "Marble", "SmoothPlastic", "Ice" },
        value = "Metal",
        callback = function(v)
            A.Material = firstOf(v) or "Metal"
            armorLook()
        end,
    })

    tab:CreateSection({ name = "Cloak" })
    addSlider(tab, "Cloak sway strength", "Armor", A, "CloakSway", 0, 2.5, 0.05)
