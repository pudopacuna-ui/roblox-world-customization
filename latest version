-- objects that the game created are stashed (not destroyed) so they can be restored
local stash = {}

local function stashChildren(className)
    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA(className) and not obj:GetAttribute("WE") then
            stash[#stash + 1] = obj
            obj.Parent = nil
        end
    end
end

local function restoreChildren(className)
    for i = #stash, 1, -1 do
        local obj = stash[i]
        if obj:IsA(className) then
            obj.Parent = Lighting
            table.remove(stash, i)
        end
    end
end

local function ensureEffect(className, name)
    local obj = Lighting:FindFirstChild(name)
    if not obj then
        obj = Instance.new(className)
        obj.Name = name
        obj:SetAttribute("WE", true)
        obj.Parent = Lighting
    end
    return obj
end

local flashTime, flashing = 0, false
local touched = {}

local function lightingStep(dt)
    local L = Config.Lighting
    if L.CycleSpeed ~= 0 then
        L.ClockTime = (L.ClockTime + dt * L.CycleSpeed) % 24
    end
    local target = {}
    for _, p in ipairs(LIGHT_PROPS) do target[p] = L[p] end
    target.FogStart = L.FogOn and L.FogStart or 0
    target.FogEnd   = L.FogOn and L.FogEnd or 100000

    for _, p in ipairs(LIGHT_PROPS) do
        local v = target[p]
        if v ~= ORIGINAL[p] then
            touched[p] = true
            Lighting[p] = v
        elseif touched[p] then
            touched[p] = nil
            Lighting[p] = v
        end
    end

    -- lightning flash (exposure spike)
    if flashTime > 0 then
        flashTime = flashTime - dt
        flashing = true
        Lighting.ExposureCompensation = target.ExposureCompensation + 1.6
    elseif flashing then
        flashing = false
        Lighting.ExposureCompensation = target.ExposureCompensation
    end
end

local function applyVisuals()
    if not visualsEnabled then return end

    -- sky
    local S = Config.Sky
    if S.Enabled then
        stashChildren("Sky")
        local sky = ensureEffect("Sky", "WE_Sky")
        local faces = {
            SkyboxBk = S.Bk, SkyboxDn = S.Dn, SkyboxFt = S.Ft,
            SkyboxLf = S.Lf, SkyboxRt = S.Rt, SkyboxUp = S.Up,
        }
        for prop, id in pairs(faces) do
            if id ~= "" and sky[prop] ~= id then sky[prop] = id end
        end
        sky.StarCount = S.StarCount
        sky.SunAngularSize = S.SunSize
        sky.MoonAngularSize = S.MoonSize
        sky.CelestialBodiesShown = S.CelestialBodies
        sky.SkyboxOrientation = V3(0, S.Rotation, 0)
    else
        local own = Lighting:FindFirstChild("WE_Sky")
        if own then own:Destroy() end
        restoreChildren("Sky")
    end

    -- atmosphere
    local A = Config.Atmosphere
    stashChildren("Atmosphere")
    local atmo = ensureEffect("Atmosphere", "WE_Atmo")
    atmo.Density = A.Enabled and A.Density or 0
    atmo.Offset, atmo.Color, atmo.Decay, atmo.Glare, atmo.Haze = A.Offset, A.Color, A.Decay, A.Glare, A.Haze

    -- post processing
    local P = Config.Post
    local cc = ensureEffect("ColorCorrectionEffect", "WE_CC")
    cc.Enabled = P.Enabled
    cc.Brightness, cc.Contrast, cc.Saturation, cc.TintColor = P.Brightness, P.Contrast, P.Saturation, P.TintColor

    local bloom = ensureEffect("BloomEffect", "WE_Bloom")
    bloom.Enabled = P.Enabled
    bloom.Intensity, bloom.Size, bloom.Threshold = P.Bloom, P.BloomSize, P.BloomThreshold

    local rays = ensureEffect("SunRaysEffect", "WE_Rays")
    rays.Enabled = P.Enabled
    rays.Intensity, rays.Spread = P.SunRays, 0.5

    local blur = ensureEffect("BlurEffect", "WE_Blur")
    blur.Size = P.Blur
    blur.Enabled = P.Enabled and P.Blur > 0
end

local function enableVisuals()
    visualsEnabled = true
    applyVisuals()
end

