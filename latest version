local weatherLabels = { None = "off", Rain = "Rain", Storm = "Thunderstorm", Snow = "Snow", Ash = "Ash", Embers = "Embers" }
local weatherPart, weatherEmitter
local weatherYOffset = 45
local weatherToggles = {}
local weatherTag, presetTag

local function syncWeatherUI()
    local kind = Config.Weather.Type
    for key, toggle in pairs(weatherToggles) do
        pcall(function() toggle:Set(key == kind, true) end)
    end
    if weatherTag then
        pcall(function()
            if kind == "None" then
                weatherTag:Set({ text = "Weather: off", color = rgb(110, 110, 130) })
            else
                weatherTag:Set({ text = "Weather: " .. weatherLabels[kind], color = rgb(70, 190, 110) })
            end
        end)
    end
end

local function updateWeather()
    local W = Config.Weather
    if W.Type == "None" then
        if weatherPart then
            weatherPart:Destroy()
            weatherPart, weatherEmitter = nil, nil
        end
        syncWeatherUI()
        return
    end

    if not weatherPart then
        weatherPart = Instance.new("Part")
        weatherPart.Name = "WE_Weather"
        weatherPart.Anchored, weatherPart.CanCollide, weatherPart.CanQuery, weatherPart.CanTouch = true, false, false, false
        weatherPart.Transparency = 1
        weatherPart.Size = V3(90, 1, 90)
        weatherPart.Parent = workspace
        weatherEmitter = Instance.new("ParticleEmitter")
        weatherEmitter.Parent = weatherPart
    end

    local e, k = weatherEmitter, W.Intensity
    e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    e.EmissionDirection = Enum.NormalId.Bottom
    weatherYOffset = 45
    local windMul = 1

    if W.Type == "Snow" then
        e.Orientation = Enum.ParticleOrientation.FacingCamera
        e.Color = ColorSequence.new(rgb(255, 255, 255))
        e.Size = NumberSequence.new(0.35)
        e.Transparency = NumberSequence.new(0.15)
        e.Lifetime = NumberRange.new(6, 8)
        e.Speed = NumberRange.new(5, 9)
        e.SpreadAngle = Vector2.new(25, 25)
        e.RotSpeed = NumberRange.new(-60, 60)
        e.Rate = 350 * k
        e.LightEmission = 0.3
    elseif W.Type == "Ash" then
        e.Orientation = Enum.ParticleOrientation.FacingCamera
        e.Color = ColorSequence.new(rgb(140, 135, 135))
        e.Size = NumberSequence.new(0.3)
        e.Transparency = NumberSequence.new(0.3)
        e.Lifetime = NumberRange.new(8, 10)
        e.Speed = NumberRange.new(2, 4)
        e.SpreadAngle = Vector2.new(40, 40)
        e.RotSpeed = NumberRange.new(-30, 30)
        e.Rate = 200 * k
        e.LightEmission = 0
    elseif W.Type == "Embers" then
        weatherYOffset = -4
        e.EmissionDirection = Enum.NormalId.Top
        e.Orientation = Enum.ParticleOrientation.FacingCamera
        e.Color = ColorSequence.new(rgb(255, 150, 40), rgb(255, 60, 10))
        e.Size = NumberSequence.new(0.35, 0)
        e.Transparency = NumberSequence.new(0)
        e.Lifetime = NumberRange.new(4, 6)
        e.Speed = NumberRange.new(6, 10)
        e.SpreadAngle = Vector2.new(30, 30)
        e.RotSpeed = NumberRange.new(0)
        e.Rate = 150 * k
        e.LightEmission = 1
    else -- Rain / Storm
        windMul = 6
        e.Orientation = Enum.ParticleOrientation.VelocityParallel
        e.Color = ColorSequence.new(rgb(170, 190, 230))
        e.Size = NumberSequence.new(0.2)
        e.Transparency = NumberSequence.new(0.45)
        e.Lifetime = NumberRange.new(0.5, 0.7)
        e.Speed = NumberRange.new(90, 110)
        e.SpreadAngle = Vector2.new(3, 3)
        e.RotSpeed = NumberRange.new(0)
        e.Rate = (W.Type == "Storm" and 1500 or 800) * k
        e.LightEmission = 0.1
    end

    local ang = math.rad(W.WindAngle)
    local push = W.Wind * windMul
    e.Acceleration = V3(math.cos(ang) * push, 0, math.sin(ang) * push)
    syncWeatherUI()
end

