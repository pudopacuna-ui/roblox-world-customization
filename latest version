----------------------------------------------------------------------
-- GEAR: part spawning
----------------------------------------------------------------------
local function destroyEntry(e)
    if e.conn then e.conn:Disconnect() end
    pcall(function() e.model:Destroy() end)
end

-- creates real Parts from the specs and welds them to `attach`
local function spawnParts(specs, attach, sc)
    local model = Instance.new("Model")
    model.Name = "WE_Gear"
    local entry = { model = model, parts = {}, anim = {}, base = CF() }

    for _, s in ipairs(specs) do
        local p = Instance.new(s.wedge and "WedgePart" or "Part")
        if s.shape then p.Shape = s.shape end
        p.Size = V3(
            math.max(s.size.X * sc, 0.05),
            math.max(s.size.Y * sc, 0.05),
            math.max(s.size.Z * sc, 0.05))
        p.Name = "WE_GearPart"
        p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
        p.CanCollide, p.CanQuery, p.CanTouch, p.Massless = false, false, false, true
        p.CastShadow = false

        local cf = CF(s.cf.Position * sc) * s.cf.Rotation
        local w = Instance.new("Weld")
        w.Part0, w.Part1, w.C0 = attach, p, cf
        w.Parent = p

        local rec = {
            part = p, weld = w, cf = cf, role = s.role,
            spin = s.spin, bob = s.bob and s.bob * sc, chain = s.chain,
        }
        if s.light then
            local l = Instance.new("PointLight")
            l.Range, l.Brightness, l.Shadows = 9, 1, false
            l.Parent = p
            rec.lightObj = l
        end

        p.Parent = model
        entry.parts[#entry.parts + 1] = rec
        if rec.spin or rec.bob or rec.chain then
            entry.anim[#entry.anim + 1] = rec
        end
    end
    return entry
end

----------------------------------------------------------------------
-- HATS: logic
----------------------------------------------------------------------
function removeHat(key)
    local e = worn[key]
    worn[key] = nil
    if e then destroyEntry(e) end
end

function hatLook()
    local H, Ch = Config.Hat, Config.Character
    local main, accent = H.Color, H.Accent
    if H.Rainbow then
        local t = tick()
        main   = Color3.fromHSV((t % 4) / 4, 1, 1)
        accent = Color3.fromHSV(((t + 2) % 4) / 4, 1, 1)
    end
    local mat = Enum.Material[H.Material]

    for _, hat in pairs(worn) do
        for _, e in ipairs(hat.parts) do
            local p = e.part
            if p.Parent then
                local col = (e.role == "main") and main or accent
                local m = (e.role == "glow" or H.Neon) and Enum.Material.Neon or mat
                if p.Color ~= col then p.Color = col end
                if p.Material ~= m then p.Material = m end
                if p.Transparency ~= H.Transparency then p.Transparency = H.Transparency end
            end
        end
        local hl = hat.model:FindFirstChild("WE_HatHL")
        if H.Highlight then
            if not hl then
                hl = Instance.new("Highlight")
                hl.Name = "WE_HatHL"
                hl.Adornee = hat.model
                hl.Parent = hat.model
            end
            hl.FillColor, hl.OutlineColor, hl.FillTransparency = Ch.Fill, Ch.Outline, Ch.FillTransparency
        elseif hl then
            hl:Destroy()
        end
    end
end

function applyHatOffsets()
    local base = CF(0, Config.Character.HatY, -Config.Character.HatZ)
    for _, hat in pairs(worn) do
        hat.base = base
        for _, e in ipairs(hat.parts) do
            if e.weld.Parent and not (e.spin or e.bob) then
                e.weld.C0 = base * e.cf
            end
        end
    end
end

local function hatTick()
    local t = tick()
    for _, hat in pairs(worn) do
        for _, e in ipairs(hat.anim) do
            if e.weld.Parent then
                if e.spin then
                    e.weld.C0 = hat.base * CF(e.cf.Position) * CFrame.Angles(0, t * e.spin, 0) * e.cf.Rotation
                elseif e.bob then
                    e.weld.C0 = hat.base * CF(0, math.sin(t * 2.2) * e.bob, 0) * e.cf
                end
            end
        end
    end
    if Config.Hat.Rainbow then hatLook() end
end

----------------------------------------------------------------------
-- ARMOR: cloak physics
-- every row is a hinge; angles follow the character's velocity
----------------------------------------------------------------------
local function cloakStep(e, dt, t, root)
    local cl, A = e.cloak, Config.Armor
    local vf, vx, vy = 0, 0, 0
    if root and e.attach.Parent then
        local rel = e.attach.CFrame:VectorToObjectSpace(root.AssemblyLinearVelocity)
        vf, vx, vy = -rel.Z, rel.X, rel.Y
    end
    vf, vx, vy = math.clamp(vf, -40, 40), math.clamp(vx, -40, 40), math.clamp(vy, -80, 80)

    local sway = A.CloakSway
    local targetX = -math.clamp(vf * 0.045 + math.max(-vy, 0) * 0.012, -0.15, 1.15) * sway
    local targetZ = -vx * 0.02 * sway
    local n, aX, aZ = cl.rows, cl.aX, cl.aZ

    for r = 1, n do
        local k = math.min(1, dt * (16 - r * 1.3))
        local flutter = math.sin(t * 2.1 + r * 0.8) * 0.035 * sway * (0.4 + r / n)
        aX[r] = aX[r] + (targetX * (r / n) + flutter - aX[r]) * k
        aZ[r] = aZ[r] + (targetZ * (r / n) - aZ[r]) * k
    end

    for ci = 1, cl.cols do
        local cf = CF(cl.xs[ci], 0, 0)
        local flare = (ci - (cl.cols + 1) / 2) * 0.022
        local row = cl.chain[ci]
        for r = 1, n do
            local px = r > 1 and aX[r - 1] or 0
            local pz = r > 1 and aZ[r - 1] or 0
            cf = cf * CFrame.Angles(aX[r] - px, 0, aZ[r] - pz + flare)
            row[r] = cf
            cf = cf * CF(0, -cl.rowH, 0)
        end
    end

    for _, rec in ipairs(e.anim) do
        local ch = rec.chain
        if ch and rec.weld.Parent then
            rec.weld.C0 = cl.base * cl.chain[ch.c][ch.r] * rec.cf
        end
    end
end

local function armorTick(dt)
    local t = tick()
    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    for _, e in pairs(armorWorn) do
        if e.cloak then cloakStep(e, dt, t, root) end
    end
end

-- one shared loop for all gear; disconnects itself when nothing is worn
local function ensureLoop()
    if gearConn then return end
    gearConn = RunService.RenderStepped:Connect(function(dt)
        local anyHat, anyArmor = next(worn) ~= nil, next(armorWorn) ~= nil
        if not anyHat and not anyArmor then
            gearConn:Disconnect()
            gearConn = nil
            return
        end
        if anyHat then hatTick() end
        if anyArmor then armorTick(dt) end
    end)
end

function addHat(key)
    if worn[key] or pending[key] then return end
    local fn = ScriptHats[key]
    if not fn then return end
    pending[key] = true

    task.spawn(function()
        local char = lp.Character
        local head = char and char:WaitForChild("Head", 5)
        pending[key] = nil
        if destroyed then return end
        if not head or worn[key] then
            if not head then notify("Hats", "No character/head found - equip the hat after respawning.") end
            return
        end

        local specs = {}
        local S = makeBuilder(specs)
        local sc = Config.Hat.Scale * math.min(head.Size.X, head.Size.Z)   -- fits R6 and R15 heads
        fn(S, head.Size.Y / 2 / sc)

        local entry = spawnParts(specs, head, sc)
        entry.model.Name = "WE_Hat"
        entry.model.Parent = workspace
        entry.conn = head.Destroying:Connect(function()
            if worn[key] == entry then removeHat(key) else destroyEntry(entry) end
        end)
        worn[key] = entry

        applyHatOffsets()
        hatLook()
        ensureLoop()
    end)
end

function syncHats()
    local want = {}
    for _, name in ipairs(selectedHats) do
        if ScriptHats[name] then want[name] = true end
    end
    for key, e in pairs(worn) do
        if not want[key] or not e.model.Parent then removeHat(key) end
    end
    for key in pairs(want) do addHat(key) end
end

local rebuildToken = 0
function rebuildHats()      -- rebuild after a size change (debounced to avoid lag)
    rebuildToken = rebuildToken + 1
    local mine = rebuildToken
    task.delay(0.3, function()
        if mine ~= rebuildToken or destroyed then return end
        for key in pairs(worn) do removeHat(key) end
        syncHats()
    end)
end

----------------------------------------------------------------------
-- ARMOR: logic
----------------------------------------------------------------------
local function rigOf(char)
    return char:FindFirstChild("UpperTorso") and "R15" or "R6"
end

local function getArmorRoot()
    if not (armorRoot and armorRoot.Parent) then
        armorRoot = Instance.new("Model")
        armorRoot.Name = "WE_Armor"
        armorRoot.Parent = workspace
    end
    return armorRoot
end

function removeArmor(key)
    local e = armorWorn[key]
    armorWorn[key] = nil
    if e then destroyEntry(e) end
end

function clearArmor()
    for key in pairs(armorWorn) do removeArmor(key) end
    if armorRoot then
        armorRoot:Destroy()
        armorRoot = nil
    end
end

function armorLook()
    local A, Ch = Config.Armor, Config.Character
    local palette = { main = A.Main, trim = A.Trim, glow = A.Glow, cloth = A.Cloth, fur = A.Fur }
    local mat = Enum.Material[A.Material]

    for _, e in pairs(armorWorn) do
        for _, r in ipairs(e.parts) do
            local p = r.part
            if p.Parent then
                local role = r.role
                local col = palette[role] or A.Main
                local m = mat
                if role == "glow" then
                    m = Enum.Material.Neon
                elseif role == "cloth" or role == "fur" then
                    m = Enum.Material.Fabric
                end
                local tr = (role == "glow") and math.min(A.Transparency, 0.6) or A.Transparency
                if p.Color ~= col then p.Color = col end
                if p.Material ~= m then p.Material = m end
                if p.Transparency ~= tr then p.Transparency = tr end
            end
            if r.lightObj then
                r.lightObj.Color = A.Glow
                r.lightObj.Brightness = A.GlowLight
            end
        end
    end

    if armorRoot and armorRoot.Parent then
        local hl = armorRoot:FindFirstChild("WE_ArmorHL")
        if A.Highlight then
            if not hl then
                hl = Instance.new("Highlight")
                hl.Name = "WE_ArmorHL"
                hl.Adornee = armorRoot
                hl.Parent = armorRoot
            end
            hl.FillColor, hl.OutlineColor, hl.FillTransparency = Ch.Fill, Ch.Outline, Ch.FillTransparency
        elseif hl then
            hl:Destroy()
        end
    end
end

local function addArmor(key, piece, partName)
    if armorWorn[key] or armorPending[key] then return end
    armorPending[key] = true

    task.spawn(function()
        local char = lp.Character
        local part = char and char:WaitForChild(partName, 5)
        armorPending[key] = nil
        if destroyed or not part or armorWorn[key] then return end

        local specs = {}
        local S = makeBuilder(specs)
        local sz = part.Size
        piece.build(S,
            { hx = sz.X / 2, hy = sz.Y / 2, hz = sz.Z / 2, part = part },
            { s = partName:find("Left") and -1 or 1, rig = rigOf(char), name = partName })

        local entry = spawnParts(specs, part, 1)
        entry.attach, entry.cloak = part, S.meta.cloak
        entry.model.Name = "WE_Armor_" .. piece.name
        entry.model.Parent = getArmorRoot()
        entry.conn = part.Destroying:Connect(function()
            if armorWorn[key] == entry then removeArmor(key) else destroyEntry(entry) end
        end)
        armorWorn[key] = entry

        if entry.cloak then
            cloakStep(entry, 1, tick(), char:FindFirstChild("HumanoidRootPart"))
        end
        armorLook()
        ensureLoop()
    end)
end

function syncArmor()
    local want = {}
    local char = lp.Character
    if char then
        local rig = rigOf(char)
        for _, pieceName in ipairs(selectedArmor) do
            local piece = ArmorByName[pieceName]
            if piece then
                for _, partName in ipairs(piece.attach(rig)) do
                    want[pieceName .. "|" .. partName] = { piece, partName }
                end
            end
        end
    end
    for key, e in pairs(armorWorn) do
        if not want[key] or not e.model.Parent then removeArmor(key) end
    end
    for key, v in pairs(want) do addArmor(key, v[1], v[2]) end

    if next(armorWorn) == nil and next(armorPending) == nil and armorRoot then
        armorRoot:Destroy()
        armorRoot = nil
    end
end

local function clearAllGear()
    for key in pairs(worn) do removeHat(key) end
    clearArmor()
    table.clear(pending)
    table.clear(armorPending)
end

