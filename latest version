defArmor("Cloak", function(rig)
    return rig == "R15" and { "UpperTorso" } or { "Torso" }
end, function(S, c)
    local hx, hy, hz = c.hx, c.hy, c.hz
    local cols, rows = 5, 8
    local rowH = (hy * 2 + 2.9) / rows
    local widthTop, widthBot = hx * 2 + 0.5, hx * 2 + 1.9

    local xs = {}
    for ci = 1, cols do
        xs[ci] = (ci - (cols + 1) / 2) * (widthTop / cols)
    end

    for ci = 1, cols do
        for r = 1, rows do
            S.setChain(ci, r)
            local w = (widthTop + (widthBot - widthTop) * (r - 1) / (rows - 1)) / cols
            S.block(V3(w * 1.25, rowH * 1.1, 0.07), CF(0, -rowH / 2, (ci % 2) * 0.012),
                r == 1 and "fur" or "cloth")
        end
        -- ragged bottom edge
        S.setChain(ci, rows)
        local w = widthBot / cols
        local l1 = 0.5 + 0.22 * math.sin(ci * 2.3)
        local l2 = 0.5 + 0.22 * math.sin(ci * 3.7 + 1)
        S.tri(V3(-w * 0.62, -rowH * 1.02, 0), V3(0, -rowH * 1.02, 0), V3(-w * 0.31, -rowH - l1, 0), "cloth")
        S.tri(V3(0, -rowH * 1.02, 0), V3(w * 0.62, -rowH * 1.02, 0), V3(w * 0.31, -rowH - l2, 0), "cloth")
    end
    S.setChain(nil)

    local cl = {
        base = CF(0, hy - 0.1, hz + 0.28), cols = cols, rows = rows, rowH = rowH, xs = xs,
        aX = {}, aZ = {}, chain = {},
    }
    for ci = 1, cols do cl.chain[ci] = {} end
    for r = 1, rows do cl.aX[r], cl.aZ[r] = 0, 0 end
    S.meta.cloak = cl
end)

