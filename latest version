-- registry of controls so they can be refreshed after a preset / config load
local controls = {}

local function track(handle, tbl, key, min, max)
    controls[#controls + 1] = { h = handle, t = tbl, k = key, min = min, max = max }
end

local function refreshControls()
    for _, c in ipairs(controls) do
        local v = c.t[c.k]
        if c.min then v = math.clamp(v, c.min, c.max) end
        pcall(function() c.h:Set(v, true) end)
    end
    syncWeatherUI()
end

local function addSlider(tab, name, prefix, tbl, key, min, max, inc, suffix, onChange)
    local h = tab:CreateSlider({
        name = name,
        flag = prefix .. "_" .. key,
        range = { min, max },
        increment = inc,
        value = math.clamp(tbl[key], min, max),
        suffix = suffix,
        callback = function(v)
            tbl[key] = v
            if onChange then onChange() end
        end,
    })
    track(h, tbl, key, min, max)
    return h
end

local function addToggle(tab, name, prefix, tbl, key, onChange)
    local h = tab:CreateToggle({
        name = name,
        flag = prefix .. "_" .. key,
        value = tbl[key] and true or false,
        callback = function(v)
            tbl[key] = v
            if onChange then onChange() end
        end,
    })
    track(h, tbl, key)
    return h
end

local function addColor(tab, name, prefix, tbl, key, onChange)
    local h = tab:CreateColorPicker({
        name = name,
        flag = prefix .. "_" .. key,
        color = tbl[key],
        callback = function(c)
            tbl[key] = c
            if onChange then onChange() end
