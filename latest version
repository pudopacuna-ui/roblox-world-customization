-- Configs -------------------------------------------------------------
do
    local tab = ui:CreateTab({ name = "Configs" })
    local cfgName, selected = "", nil

    local function clean(name)
        return (tostring(name):gsub("[^%w_%- ]", ""))
    end

    tab:CreateSection({ name = "Save current settings" })
    tab:CreateInput({
        name = "Config name",
        placeholder = "for example: night_vibe",
        forgetState = true,
        flag = "Cfg_Name",
        callback = function(text) cfgName = clean(text) end,
    })

    local listDropdown
    local function refreshList()
        local ok, list = pcall(function() return ui:ListConfigs() end)
        if ok and listDropdown then
            pcall(function() listDropdown:Refresh(list or {}) end)
        end
    end

    tab:CreateButton({
        name = "Save",
        callback = function()
            if cfgName == "" then
                notify("Config", "Type a config name first.")
                return
            end
            local ok = ui:Save(cfgName)
            notify("Config", ok and ("Saved: " .. cfgName) or "Could not save (your executor needs writefile).")
            refreshList()
        end,
    })

    tab:CreateSection({ name = "Saved configs" })
    local okList, list = pcall(function() return ui:ListConfigs() end)
    listDropdown = tab:CreateDropdown({
        name = "Pick a config",
        flag = "Cfg_List",
        forgetState = true,
        options = okList and list or {},
        placeholder = "no saved configs",
        callback = function(v) selected = firstOf(v) end,
    })

    tab:CreateButton({
        name = "Load selected",
        callback = function()
            if not selected then
                notify("Config", "Pick a config from the list.")
                return
            end
            local ok = ui:Load(selected)
            visualsEnabled, charEnabled = true, true
            applyVisuals()
            applyCharacter()
            updateWeather()
            syncHats()
            syncArmor()
            armorLook()
            hatLook()
            notify("Config", ok and ("Loaded: " .. selected) or "Could not load.")
        end,
    })
    tab:CreateButton({
        name = "Delete selected",
        callback = function()
            if not selected then
                notify("Config", "Pick a config from the list.")
                return
            end
            local ok = ui:DeleteConfig(selected)
            notify("Config", ok and ("Deleted: " .. selected) or "Could not delete.")
            selected = nil
            refreshList()
        end,
    })
    tab:CreateButton({ name = "Refresh list", callback = refreshList })
end

