local lightningTimer, secondTimer = 0, 0

RunService:BindToRenderStep("WE_Loop", Enum.RenderPriority.Last.Value, function(dt)
    lightingStep(dt)

    -- the weather emitter follows the camera
    local cam = workspace.CurrentCamera
    if weatherPart and cam then
        weatherPart.CFrame = CFrame.new(cam.CFrame.Position + V3(0, weatherYOffset, 0))
    end

    -- random lightning flashes during a thunderstorm
    if Config.Weather.Type == "Storm" and Config.Weather.Lightning then
        lightningTimer = lightningTimer - dt
        if lightningTimer <= 0 then
            flashTime = 0.12
            lightningTimer = math.random(40, 120) / 10
        end
    end

    -- rainbow mode: cycle the shared highlight colors every frame
    if Config.Character.Rainbow and charEnabled then
        local col = Color3.fromHSV(tick() % 4 / 4, 1, 1)
        Config.Character.Fill, Config.Character.Outline = col, col
        local char = lp.Character
        local hl = char and char:FindFirstChild("WE_HL")
        if hl then hl.FillColor, hl.OutlineColor = col, col end
        local ahl = armorRoot and armorRoot:FindFirstChild("WE_ArmorHL")
        if ahl then ahl.FillColor, ahl.OutlineColor = col, col end
        for _, hat in pairs(worn) do
            local hhl = hat.model:FindFirstChild("WE_HatHL")
            if hhl then hhl.FillColor, hhl.OutlineColor = col, col end
        end
    end

    -- once per second: re-apply (the game may have replaced objects)
    secondTimer = secondTimer + dt
    if secondTimer >= 1 then
        secondTimer = 0
        applyVisuals()
        applyCharacter()
    end
end)

local charAddedConn = lp.CharacterAdded:Connect(function()
    clearAllGear()
    task.wait(1.5)
    if destroyed then return end
    applyCharacter()
    syncHats()
    syncArmor()
end)

local inputConn = UserInputService.InputBegan:Connect(function(input, processed)
    if not processed and input.KeyCode == Enum.KeyCode.RightShift then
        pcall(function() ui:ToggleHide() end)
    end
end)

env.WorldEditor = {
    Config = Config,
    Window = ui,
    Preset = applyPreset,
    Apply = function()
        visualsEnabled, charEnabled = true, true
        refreshAll()
    end,
    Destroy = function()
        destroyed = true
        pcall(function() RunService:UnbindFromRenderStep("WE_Loop") end)
        charAddedConn:Disconnect()
        inputConn:Disconnect()
        if gearConn then
            gearConn:Disconnect()
            gearConn = nil
        end

        -- restore lighting
        for _, p in ipairs(LIGHT_PROPS) do Lighting[p] = ORIGINAL[p] end
        for _, n in ipairs({ "WE_Sky", "WE_Atmo", "WE_CC", "WE_Bloom", "WE_Rays", "WE_Blur" }) do
            local obj = Lighting:FindFirstChild(n)
            if obj then obj:Destroy() end
        end
        restoreChildren("Sky")
        restoreChildren("Atmosphere")

        -- weather
        if weatherPart then weatherPart:Destroy() end

        -- hats and armor
        clearAllGear()

        -- character
        local char = lp.Character
        if char then
            local hl = char:FindFirstChild("WE_HL")
            if hl then hl:Destroy() end
            for part, orig in pairs(bodyOriginals) do
                if part.Parent then
                    part.Color, part.Material, part.Transparency = orig[1], orig[2], orig[3]
                end
            end
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                for _, n in ipairs({ "WE_Trail", "WE_A0", "WE_A1", "WE_Aura" }) do
                    local obj = root:FindFirstChild(n)
                    if obj then obj:Destroy() end
                end
            end
        end

        pcall(function() ui:Unload() end)
        env.WorldEditor = nil
    end,
}

task.defer(function()
    -- if autoload restored non-default values, switch the matching systems on
    local changed = false
    for _, cat in ipairs({ "Atmosphere", "Post", "Sky" }) do
        for key, v in pairs(Config[cat]) do
            if v ~= DEFAULTS[cat][key] then changed = true end
        end
    end
    for key, v in pairs(Config.Character) do
        if v ~= DEFAULTS.Character[key] then charEnabled = true end
    end
    if changed then visualsEnabled = true end

    refreshAll()
    syncWeatherUI()
    syncHats()
    syncArmor()
    notify("World Editor ready", "Menu: RightShift. Configs are on the Configs tab.")
end)
